generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(uuid())
  emri         String
  email        String   @unique
  passwordHash String
  telefon      String?
  roli         String   @default("klient")
  dataKrijimit DateTime @default(now())

  quizResults     QuizResult[]
  faceScans       FaceScan[]
  cartItems       CartItem[]
  orders          Order[]
  aiConversations AiConversation[]
  appointments    Appointment[]

  dermatologist Dermatologist?

  @@index([email])
  @@map("users")
}

model Dermatologist {
  id              String  @id @default(uuid())
  userId          String  @unique
  specializimi    String
  bio             String?
  vitiEksperience Int?
  fotoUrl         String?
  iVerifikuar     Boolean @default(false)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  services     DermatologistService[]
  availability DermatologistAvailability[]
  appointments Appointment[]

  @@index([iVerifikuar])
  @@map("dermatologists")
}

model QuizQuestion {
  id       String @id @default(uuid())
  teksti   String
  renditja Int    @unique

  options QuizOption[]

  @@map("quiz_questions")
}

model QuizOption {
  id             String @id @default(uuid())
  questionId     String
  teksti         String
  pikeThatesi    Int    @default(0)
  pikeYndyre     Int    @default(0)
  pikeNdjeshmeri Int    @default(0)
  pikeAkne       Int    @default(0)

  question QuizQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@index([questionId])
  @@map("quiz_options")
}

model QuizResult {
  id         String   @id @default(uuid())
  userId     String
  tipiLekure String
  problemet  String
  data       DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  recommendedProducts RecommendedProduct[]

  @@index([userId])
  @@index([tipiLekure])
  @@map("quiz_results")
}

model FaceScan {
  id        String   @id @default(uuid())
  userId    String
  imageUrl  String
  aiAnaliza String?
  data      DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("face_scans")
}

model Category {
  id   String @id @default(uuid())
  emri String @unique

  products Product[]

  @@map("categories")
}

model Product {
  id                     String   @id @default(uuid())
  emri                   String
  pershkrimi             String?
  cmimi                  Float
  marka                  String?
  kategoriaId            String?
  stoku                  Int      @default(0)
  tipiLekurePershtatshem String?
  nePromovim             Boolean  @default(false)
  dataShtimit            DateTime @default(now())

  kategoria Category? @relation(fields: [kategoriaId], references: [id], onDelete: SetNull)

  images              ProductImage[]
  ingredients         ProductIngredient[]
  recommendedProducts RecommendedProduct[]
  cartItems           CartItem[]
  orderItems          OrderItem[]

  @@index([kategoriaId])
  @@index([emri])
  @@index([marka])
  @@map("products")
}

model ProductImage {
  id        String @id @default(uuid())
  productId String
  url       String
  renditja  Int    @default(0)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@map("product_images")
}

model Ingredient {
  id        String  @id @default(uuid())
  emri      String  @unique
  perfitimi String?

  products ProductIngredient[]

  @@map("ingredients")
}

model ProductIngredient {
  productId    String
  ingredientId String

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  ingredient Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Cascade)

  @@id([productId, ingredientId])
  @@index([ingredientId])
  @@map("product_ingredients")
}

model RecommendedProduct {
  id           String  @id @default(uuid())
  quizResultId String
  productId    String
  arsyeja      String?
  renditjaHapi Int     @default(0)

  quizResult QuizResult @relation(fields: [quizResultId], references: [id], onDelete: Cascade)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([quizResultId, productId])
  @@index([productId])
  @@index([quizResultId])
  @@map("recommended_products")
}

model CartItem {
  id          String   @id @default(uuid())
  userId      String
  productId   String
  sasia       Int      @default(1)
  dataShtimit DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  product Product @relation(fields: [productId], references: [id])

  @@unique([userId, productId])
  @@index([userId])
  @@index([productId])
  @@map("cart_items")
}

model Order {
  id            String   @id @default(uuid())
  userId        String
  totali        Float
  statusi       String   @default("pritje")
  adresa        String?
  menyraPageses String   @default("cash")
  data          DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  items OrderItem[]

  @@index([userId])
  @@index([statusi])
  @@index([data])
  @@map("orders")
}

model OrderItem {
  id          String @id @default(uuid())
  orderId     String
  productId   String
  sasia       Int
  cmimiAthere Float

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  product Product @relation(fields: [productId], references: [id])

  @@index([orderId])
  @@index([productId])
  @@map("order_items")
}

model AiConversation {
  id           String   @id @default(uuid())
  userId       String
  tipiAgjenti  String
  dataFillimit DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  messages AiMessage[]

  @@index([userId])
  @@map("ai_conversations")
}

model AiMessage {
  id             String   @id @default(uuid())
  conversationId String
  dergues        String
  permbajtja     String
  data           DateTime @default(now())

  conversation AiConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@map("ai_messages")
}

model Service {
  id          String  @id @default(uuid())
  emri        String
  pershkrimi  String?
  kohezgjatja Int?
  cmimi       Float
  tipi        String

  dermatologists DermatologistService[]
  appointments   Appointment[] @relation("SherbimiKryesor")
  takimet        Appointment[] @relation("SherbimetETakimit")

  @@map("services")
}

model DermatologistService {
  dermatologistId String
  serviceId       String

  dermatologist Dermatologist @relation(fields: [dermatologistId], references: [id], onDelete: Cascade)

  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@id([dermatologistId, serviceId])
  @@index([serviceId])
  @@map("dermatologist_services")
}

model DermatologistAvailability {
  id              String   @id @default(uuid())
  dermatologistId String
  data            DateTime
  oraFillimit     String
  oraMbarimit     String
  iZene           Boolean  @default(false)

  dermatologist Dermatologist @relation(fields: [dermatologistId], references: [id], onDelete: Cascade)

  @@index([dermatologistId])
  @@index([data])
  @@map("dermatologist_availability")
}

model Appointment {
  id              String   @id @default(uuid())
  klientId        String
  dermatologistId String
  serviceId       String?
  data            DateTime
  ora             String
  statusi         String   @default("pritje")

  klient User @relation(fields: [klientId], references: [id], onDelete: Cascade)

  dermatologist Dermatologist @relation(fields: [dermatologistId], references: [id], onDelete: Cascade)

  service  Service?  @relation("SherbimiKryesor", fields: [serviceId], references: [id], onDelete: SetNull)
  services Service[] @relation("SherbimetETakimit")

  recommendations DermatologistRecommendation[]

  @@index([klientId])
  @@index([dermatologistId])
  @@index([serviceId])
  @@index([data])
  @@index([statusi])
  @@map("appointments")
}

model DermatologistRecommendation {
  id            String   @id @default(uuid())
  appointmentId String
  teksti        String
  data          DateTime @default(now())

  appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)

  @@index([appointmentId])
  @@map("dermatologist_recommendations")
}